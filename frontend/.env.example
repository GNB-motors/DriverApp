# Base URL for the API. Points at main-backend (routes are mounted at /api).
# Local dev example (Android emulator uses 10.0.2.2 for host localhost):
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api
# iOS simulator / web:
#   EXPO_PUBLIC_API_URL=http://localhost:3000/api
# Staging/prod: your deployed main-backend origin + /api
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Optional: Sentry DSN (leave blank to disable)
EXPO_PUBLIC_SENTRY_DSN=

# Browser Google Maps JavaScript key. Restrict to the app's allowed web origins.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# Android native development/production builds use a separately restricted Maps SDK key.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=

# The organization's hosted OSM/MapLibre style. No demo tile service is used in production.
# Configure a style whose tile, glyph and sprite resources belong to the geo pipeline.
EXPO_PUBLIC_MAP_STYLE_URL=
